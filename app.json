{
  "expo": {
    "name": "ITCA Go",
    "slug": "itca-go",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "itca-go",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sv.edu.itca.go"
    },
    "android": {
      "package": "sv.edu.itca.go",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#c9902b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-font",
      "@react-native-vector-icons/ionicons",
      "@maplibre/maplibre-react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#c9902b"
        }
      ],
      "expo-build-properties",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class * extends androidx.work.Worker { *; }\n-keep class * extends androidx.work.ListenableWorker { *; }\n-keep class * extends androidx.room.RoomDatabase { *; }"
          }
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "cb3d6866-1041-433e-98b7-ba693073ffa5"
      }
    },
    "owner": "proyectos.devv"
  }
}
